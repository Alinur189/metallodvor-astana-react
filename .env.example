# Скопируйте этот файл в .env и вставьте свои ID.
# Пока значение пустое — соответствующий счётчик НЕ загружается (это безопасно).

# Google Analytics 4 — формат G-XXXXXXXXXX (analytics.google.com → Admin → Data Streams)
VITE_GA4_ID=

# Google Ads — отслеживание конверсий (реклама)
# ID конверсий: формат AW-XXXXXXXXX (Google Ads → Инструменты → Конверсии)
VITE_GOOGLE_ADS_ID=
# Метки (label) действий-конверсий из Google Ads. Без метки конверсия не шлётся.
VITE_GADS_LABEL_LEAD=        # заявка с формы /contacts и модалки заказа (form_submit, order_submit)
VITE_GADS_LABEL_CALL=        # клик по телефону (phone_click)
VITE_GADS_LABEL_WHATSAPP=    # клик по WhatsApp (whatsapp_click)

# Meta (Facebook/Instagram) Pixel — числовой ID (Events Manager → Data Sources)
VITE_META_PIXEL_ID=

# Яндекс.Метрика — номер счётчика (metrika.yandex.kz → Настройка → Счётчик)
VITE_YANDEX_METRIKA_ID=
